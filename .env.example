# TrekTrak — environment configuration template.
# Copy this file to `.env.local` and fill in your keys.

# OpenRouteService API key — used for trail routing (foot-hiking).
# Get a free key at https://openrouteservice.org (sign up → Dashboard → Tokens).
# Without this key the app falls back to straight-line classic mode.
NEXT_PUBLIC_ORS_API_KEY=

# Thunderforest API key — enables the "Thunderforest Outdoors" base map
# (sentieri, curve di livello, rifugi). Get a free key at
# https://www.thunderforest.com/maps/outdoors/
# Without it, the map falls back to OpenTopoMap / CyclOSM / OpenStreetMap.
NEXT_PUBLIC_THUNDERFOREST_API_KEY=

# NASA FIRMS MAP_KEY — layer "Focolai attivi" (hotspot incendi da satellite).
# Chiave gratuita: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Server-only (usata dalla API route /api/fires): MAI prefissarla con NEXT_PUBLIC_.
# Senza chiave il layer risulta "non disponibile"; gli altri layer funzionano comunque.
FIRMS_MAP_KEY=

# --- Libreria condivisa (Supabase) — Fase 1+ ---
# Client browser (pubbliche):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (MAI con prefisso NEXT_PUBLIC, mai nel bundle client):
SUPABASE_SERVICE_ROLE_KEY=
# Token di invito in chiaro (il suo hash SHA-256 è seedato nella tabella invites):
INVITE_TOKEN=
# URL base per i redirect del magic-link:
SITE_URL=http://localhost:3000
